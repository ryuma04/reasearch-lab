{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && go build -o bin\\api.exe ./cmd/server && bin\\api.exe"],
      "port": 8080
    },
    {
      "name": "agents",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd agents && ..\\.venv\\Scripts\\python.exe -m uvicorn app:app --port 8001"],
      "port": 8001
    },
    { "name": "web", "runtimeExecutable": "npm", "runtimeArgs": ["--prefix", "frontend", "run", "dev"], "port": 3000 }
  ]
}
