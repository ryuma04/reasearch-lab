# ─────────────────────────────────────────────────────────────────────────────
# Research Lab web — environment configuration (safe placeholders only).
# Copy to .env.local and adjust. NEVER put secrets in NEXT_PUBLIC_* variables:
# they are bundled into browser JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Go backend API as seen by the browser.
#  - Direct mode: the backend origin, e.g. http://localhost:8080 (backend must enable
#    CORS for this frontend origin with Access-Control-Allow-Credentials: true).
#  - Proxy mode: "/api" together with API_PROXY_TARGET below (cookies stay first-party).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only (not exposed to the browser). When set, Next.js rewrites /api/* to this origin.
# API_PROXY_TARGET=http://localhost:8080

# Public origin of this frontend; used to build share links / QR codes when the backend
# returns only a token. Optional — defaults to window.location.origin.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# DEVELOPMENT ONLY. "true" swaps the HTTP + SSE transport for an in-browser demo backend
# with clearly labelled sample data. Ignored in production builds (NODE_ENV=production).
NEXT_PUBLIC_USE_MOCKS=false

# Email + password sign-in next to GitHub ("false" hides it). Backend: EMAIL_LOGIN_ENABLED.
NEXT_PUBLIC_EMAIL_LOGIN=true
